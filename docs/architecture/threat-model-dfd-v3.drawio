 · validation · coordinate reduction&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=13;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1089" y="367" width="331" height="465" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Telemetry ingest&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;font-weight:normal;color:#555555'&gt;validate · de-dup alerts&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=13;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1200" y="1095" width="220" height="78" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Auth service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;font-weight:normal;color:#555555'&gt;Supabase Auth · login · tokens · reset&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=13;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1603" y="141" width="318" height="77" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;font-weight:normal;color:#555555'&gt;records · users · exact GPS&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=13;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1603" y="294" width="318" height="109" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Photo storage&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;font-weight:normal;color:#555555'&gt;originals + EXIF&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=13;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1603" y="466" width="318" height="96" as="geometry"/></mxCell><mxCell i