<mxfile host="app.diagrams.net"><diagram name="DFD v0.3" id="dfd-v03"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Smart Ground-Truthing &amp;amp; Digital Biodiversity System: Data Flow Diagram (threat model v0.3)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#222222;spacing=0;" vertex="1" parent="1"><mxGeometry x="62" y="10" width="1700" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Dashed boxes are trust boundaries. Any line that crosses a dashed box carries data that must be checked." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#444444;spacing=0;" vertex="1" parent="1"><mxGeometry x="62" y="52" width="1200" height="22" as="geometry"/></mxCell><mxCell id="c4" value="UNTRUSTED: user devices on the internet" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeWidth=2.5;fillColor=#fbe9e7;strokeColor=#c0504d;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fontStyle=1;fontSize=14;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="62" y="86" width="366" height="746" as="geometry"/></mxCell><mxCell id="c5" value="SEMI-TRUSTED: public-facing tier" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeWidth=2.5;fillColor=#fff8dc;strokeColor=#c0504d;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fontStyle=1;fontSize=14;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="538" y="86" width="404" height="1113" as="geometry"/></mxCell><mxCell id="c6" value="TRUSTED: application tier (our code)" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeWidth=2.5;fillColor=#e6f0fa;strokeColor=#4a7fc0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fontStyle=1;fontSize=14;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1052" y="306" width="404" height="893" as="geometry"/></mxCell><mxCell id="c7" value="THIRD-PARTY: Supabase (hosted, not in-house)" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeWidth=2.5;fillColor=#e9e4f5;strokeColor=#7b52c7;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fontStyle=1;fontSize=14;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1566" y="86" width="441" height="1113" as="geometry"/></mxCell><mxCell id="c8" value="UNTRUSTED: field (physical, unattended)" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeWidth=2.5;fillColor=#fff0d6;strokeColor=#c0504d;html=1;whiteSpace=wrap;verticalAlign=bottom;align=left;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fontStyle=1;fontSize=14;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="62" y="881" width="366" height="306" as="geometry"/></mxCell><mxCell id="c9" value="EXTERNAL: third-party services" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeWidth=2.5;fillColor=#f0f0f0;strokeColor=#777777;html=1;whiteSpace=wrap;verticalAlign=top;align=right;spacingLeft=14;spacingRight=14;spacingTop=8;spacingBottom=8;fontStyle=1;fontSize=14;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1052" y="1248" width="563" height="183" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Botanist phone app&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px;font-weight:normal;color:#555555'&gt;(offline-first)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=13;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="98" y="141" width="293" height="85" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;On-device store&lt;/b&gt;&lt;br&gt;&lt;font