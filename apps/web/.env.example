# apps/web/.env.example
# Copy this file to .env and fill in your Supabase project credentials.
# Never commit your .env file to version control.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_API_URL=http://localhost:8000

# Local development only (CTIP-113): the prototype role switch signs in to the
# demo accounts with this password. It only works in `npm run dev`; production builds
# have no switch. Never set it on a hosting service, in eas.json or in git.
# VITE_DEMO_PASSWORD=
