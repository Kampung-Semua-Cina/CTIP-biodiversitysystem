# apps/web/.env.example
# Copy this file to .env. Never commit your .env file to version control.

# The Express API (services/api), without /v1. The website only talks to the
# API (CTIP-114): it needs no Supabase address or key. In `npm run dev` you can
# leave this out and Vite forwards /v1 to http://localhost:8000. On Cloudflare
# Pages set it to the Render address, e.g. https://daun-sense-api.onrender.com
VITE_API_URL=http://localhost:8000

# Local development only (CTIP-113): the prototype role switch signs in to the
# demo accounts with this password. It only works in `npm run dev`; production builds
# have no switch. Never set it on a hosting service, in eas.json or in git.
# VITE_DEMO_PASSWORD=
