{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ctip-biodiversitysystem.onrender.com"
      }
    },
    "preview-local": {
      "extends": "preview",
      "autoIncrement": false
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ctip-biodiversitysystem.onrender.com"
      }
    },
    "production-local": {
      "extends": "production",
      "autoIncrement": false
    }
  }
}
