# apps/mobile/.env.example
# Copy this file to .env. Never commit your .env file to version control.

# The Express API (services/api). Every screen loads and saves through it,
# signing in included (CTIP-114): the app needs no Supabase address or key.
# With `npm run start` on the same Wi-Fi you can leave this out: the app uses the
# computer running Expo (port 8000). Set it for tunnel mode and APK builds, using
# an address the phone can reach (not localhost), e.g. http://192.168.1.20:8000
# APK builds take it from eas.json instead.
# EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_IP:8000

# Local development only (CTIP-113): the prototype role switch signs in to the
# demo accounts with this password. It only works in Expo Go / a development build; production builds
# have no switch. Never set it on a hosting service, in eas.json or in git.
# EXPO_PUBLIC_DEMO_PASSWORD=
