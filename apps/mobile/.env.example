# Copy to apps/mobile/.env (never commit .env). Expo only exposes EXPO_PUBLIC_ names.
# The Express API (services/api). "localhost" on a phone means the phone itself:
#   Android emulator:   http://10.0.2.2:8000/v1
#   Phone on your Wi-Fi: http://<your computer's IP, e.g. 192.168.1.20>:8000/v1
# The phone app needs no CORS setting; only the web app does.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/v1
