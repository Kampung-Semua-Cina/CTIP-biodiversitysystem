# Copy to .env and fill in from Supabase: Project Settings > API Keys / Data API.
# Never commit .env.
#
# Hosted Supabase: also turn on the custom access token hook
# (Authentication > Hooks > Customize Access Token, function
# public.custom_access_token_hook). Without it tokens carry no user_role and
# every signed-in request gets 403 ACCOUNT_NOT_ACTIVE. Local `supabase start`
# turns it on from supabase/config.toml.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
PORT=8000
CORS_ORIGINS=http://localhost:5173

# Production only (CTIP-35). Locally leave REQUIRE_HTTPS unset so http://localhost works.
# REQUIRE_HTTPS=true rejects plain-HTTP requests with 403 HTTPS_REQUIRED and adds HSTS.
# It also refuses to start unless SUPABASE_URL and every CORS origin use https://.
# TRUST_PROXY = number of proxies in front of the API that end TLS (usually 1 on a host).
# REQUIRE_HTTPS=true
# TRUST_PROXY=1

# Signing in goes through this API (CTIP-114), so set TRUST_PROXY on the host:
# the sign-in limit (10 tries per address per 5 minutes) needs each caller's own address.
# Where password-reset emails send people. Must also be listed under Supabase:
# Authentication > URL Configuration > Redirect URLs. Unset: the Supabase Site URL.
# PASSWORD_RESET_REDIRECT_URL=https://ctip-biodiversitysystem.pages.dev/
